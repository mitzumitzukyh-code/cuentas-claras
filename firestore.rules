rules_version = '2';

// =============================================================================
// Cuenta Clara — Reglas de seguridad de Firestore
// -----------------------------------------------------------------------------
// Principio central (CLAUDE.md §4): NINGÚN usuario puede leer/escribir datos de
// un negocio donde no tenga una membresía. Esto se aplica aquí, a nivel de
// servidor — nunca solo en la UI.
//
// Roles (CLAUDE.md §6):
//   - dueno:    ve/edita todo, anula ventas, elimina productos, ve finanzas.
//   - empleado: registra ventas y ve inventario; NO ve gastos/finanzas, NO
//               anula ventas, NO elimina productos.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Helpers -----

    function estaAutenticado() {
      return request.auth != null;
    }

    // ID de membresía = "<usuarioId>_<negocioId>" (CLAUDE.md §4).
    function membresiaId(negocioId) {
      return request.auth.uid + '_' + negocioId;
    }

    function docMembresia(negocioId) {
      return /databases/$(database)/documents/membresias/$(membresiaId(negocioId));
    }

    function esMiembro(negocioId) {
      return estaAutenticado() && exists(docMembresia(negocioId));
    }

    function rolEn(negocioId) {
      return get(docMembresia(negocioId)).data.rol;
    }

    function esDueno(negocioId) {
      return esMiembro(negocioId) && rolEn(negocioId) == 'dueno';
    }

    // ¿Este usuario fundó el negocio? Es lo único que autoriza a concederse a
    // uno mismo la membresía de dueño.
    function esFundador(negocioId) {
      return estaAutenticado() &&
             exists(/databases/$(database)/documents/negocios/$(negocioId)) &&
             get(/databases/$(database)/documents/negocios/$(negocioId))
               .data.get('creadoPor', '') == request.auth.uid;
    }

    // ----- Negocios -----
    match /negocios/{negocioId} {
      allow read: if esMiembro(negocioId);
      // `creadoPor` debe ser uno mismo: es la prueba que luego permite crear la
      // membresía de dueño. Por eso el negocio se escribe ANTES que la
      // membresía, y no en el mismo batch (ver NegocioRepository.crearNegocio).
      allow create: if estaAutenticado() &&
                       request.resource.data.creadoPor == request.auth.uid;
      // `creadoPor` es inmutable: si se pudiera reescribir, un dueño podría
      // regalar (o robar) la capacidad de fundar membresías sobre el negocio.
      allow update: if esDueno(negocioId) &&
                       !('creadoPor' in request.resource.data
                           .diff(resource.data).affectedKeys());
      allow delete: if esDueno(negocioId);

      // --- Productos ---
      // Empleado puede actualizar stock (una venta descuenta cantidad), pero no
      // crear catálogo ni eliminar productos.
      match /productos/{productoId} {
        allow read:   if esMiembro(negocioId);
        allow create: if esDueno(negocioId);
        allow update: if esMiembro(negocioId);
        allow delete: if esDueno(negocioId);
      }

      // --- Insumos (solo comida_rapida) ---
      match /insumos/{insumoId} {
        allow read:   if esMiembro(negocioId);
        allow create: if esDueno(negocioId);
        allow update: if esMiembro(negocioId); // una venta descuenta insumos
        allow delete: if esDueno(negocioId);
      }

      // --- Ventas ---
      // Empleado registra ventas. Anular = update (solo dueño). Nunca se borran.
      match /ventas/{ventaId} {
        allow read:   if esMiembro(negocioId);
        allow create: if esMiembro(negocioId);
        allow update: if esDueno(negocioId);
        allow delete: if false;
      }

      // --- Gastos (información financiera: solo dueño) ---
      match /gastos/{gastoId} {
        allow read, write: if esDueno(negocioId);
      }

      // --- Fiados (Lote G) ---
      // Igual que Ventas: cualquier miembro anota fiados/abonos y ve la
      // lista de deudas (decisión de producto — no es información
      // financiera reservada al dueño como Gastos).
      match /clientes/{clienteId} {
        allow read:   if esMiembro(negocioId);
        allow create: if esMiembro(negocioId);
        // Update cubre el ajuste de `saldoUSD` al fiar/abonar.
        allow update: if esMiembro(negocioId);
        allow delete: if esDueno(negocioId);

        // El libro mayor de cada cliente nunca se edita ni se borra.
        match /movimientos/{movimientoId} {
          allow read:   if esMiembro(negocioId);
          allow create: if esMiembro(negocioId);
          allow update: if false;
          allow delete: if false;
        }
      }

      // --- Proveedores / cuentas por pagar (Lote H) ---
      // Mismo criterio que Fiados: dueño y empleados anotan y ven las deudas.
      match /proveedores/{proveedorId} {
        allow read:   if esMiembro(negocioId);
        allow create: if esMiembro(negocioId);
        allow update: if esMiembro(negocioId);
        allow delete: if esDueno(negocioId);

        match /movimientos/{movimientoId} {
          allow read:   if esMiembro(negocioId);
          allow create: if esMiembro(negocioId);
          allow update: if false;
          allow delete: if false;
        }
      }

      // --- Cierres de caja (Lote H) ---
      // Igual que Fiados/Proveedores: dueño y empleados pueden cerrar caja.
      // Un cierre nunca se edita ni se borra: es el registro de lo que pasó
      // ese día, aunque haya descuadre.
      match /cierres/{cierreId} {
        allow read:   if esMiembro(negocioId);
        allow create: if esMiembro(negocioId);
        allow update: if false;
        allow delete: if false;
      }
    }

    // ----- Membresías -----
    // La membresía ES el permiso: `esMiembro()` no comprueba otra cosa que la
    // existencia de este documento. Por eso crear una membresía tiene que ser
    // más difícil que declararse miembro — antes bastaba con poner el propio
    // uid en `usuarioId`, lo que permitía a cualquier usuario autenticado
    // escribir `membresias/{suUid}_{negocioAjeno}` con rol 'dueno' y quedarse
    // con el inventario, las ventas y los gastos de un negocio que no era suyo.
    //
    // Ahora solo hay dos caminos, y ambos exigen una prueba externa:
    //   1. Fundador — el negocio ya existe y su `creadoPor` es este usuario.
    //   2. Invitado — presenta un código vivo, sin usar, del mismo negocio y rol.
    match /membresias/{membresiaId} {
      // La invitación que respalda una membresía nueva: tiene que existir,
      // seguir sin usar, no haber caducado, y coincidir en negocio y rol con lo
      // que el usuario pretende escribir.
      function invitacionRespalda(datos) {
        return datos.get('codigoInvitacion', '') is string &&
               datos.get('codigoInvitacion', '') != '' &&
               exists(/databases/$(database)/documents/invitaciones/$(datos.codigoInvitacion)) &&
               invitacionCuadra(
                 get(/databases/$(database)/documents/invitaciones/$(datos.codigoInvitacion)).data,
                 datos
               );
      }

      function invitacionCuadra(inv, datos) {
        return inv.usado == false &&
               inv.expiraEn > request.time &&
               inv.negocioId == datos.negocioId &&
               inv.rol == datos.rol;
      }

      allow read: if estaAutenticado() &&
                     (resource.data.usuarioId == request.auth.uid ||
                      esDueno(resource.data.negocioId));

      // El ID del documento es lo que consulta `esMiembro()`, así que validar
      // solo el campo `usuarioId` no serviría de nada: hay que atar el ID.
      allow create: if estaAutenticado() &&
                       membresiaId == request.auth.uid + '_' +
                                      request.resource.data.negocioId &&
                       request.resource.data.usuarioId == request.auth.uid &&
                       (
                         (request.resource.data.rol == 'dueno' &&
                          esFundador(request.resource.data.negocioId)) ||
                         invitacionRespalda(request.resource.data)
                       );

      // El dueño cambia el rol y/o los permisos de su equipo (pantalla
      // Empleados). Solo puede tocar `rol` y `permisos`: si pudiera
      // reescribir `usuarioId` o `negocioId` movería membresías entre
      // negocios o suplantaría a otro usuario.
      allow update: if (esDueno(resource.data.negocioId) &&
                       request.resource.data.usuarioId == resource.data.usuarioId &&
                       request.resource.data.negocioId == resource.data.negocioId &&
                       request.resource.data.rol in ['dueno', 'empleado'] &&
                       request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['rol', 'permisos']))
                       ||
                       // Cualquiera puede guardar el token FCM de SU PROPIA
                       // membresía (para el resumen de ventas del Worker) —
                       // nada más: ni el rol, ni el negocio, ni de quién es.
                       (estaAutenticado() &&
                        request.auth.uid == resource.data.usuarioId &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['pushToken']) &&
                        request.resource.data.usuarioId == resource.data.usuarioId &&
                        request.resource.data.negocioId == resource.data.negocioId &&
                        request.resource.data.rol == resource.data.rol);

      allow delete: if estaAutenticado() &&
                       (resource.data.usuarioId == request.auth.uid ||
                        esDueno(resource.data.negocioId));
    }

    // ----- Invitaciones -----
    // El dueño genera códigos; un invitado autenticado puede leer para validar
    // y marcar como usado al aceptar.
    match /invitaciones/{codigo} {
      // `get` (un código concreto, por ID) sí: quien recibe la invitación
      // necesita validarla antes de aceptarla, y para eso ya tiene que conocer
      // el código. `list` no: con la colección abierta, cualquier usuario
      // autenticado podía descargar TODOS los códigos vivos con su negocioId y
      // su rol, y el secreto de 6 caracteres dejaba de ser secreto.
      allow get:    if estaAutenticado();
      allow list:   if false;
      allow create: if esDueno(request.resource.data.negocioId) &&
                       request.resource.data.usado == false;

      // Aceptar una invitación solo puede marcarla como usada. Antes esto era
      // `if estaAutenticado()`, lo que dejaba a cualquiera reescribir el rol
      // del código y colarse como dueño.
      // La caducidad de 24 h se comprobaba solo en el cliente, así que a nivel
      // de servidor un código vencido seguía siendo aceptable.
      allow update: if estaAutenticado() &&
                       resource.data.usado == false &&
                       resource.data.expiraEn > request.time &&
                       request.resource.data.usado == true &&
                       request.resource.data.negocioId == resource.data.negocioId &&
                       request.resource.data.rol == resource.data.rol &&
                       request.resource.data.expiraEn == resource.data.expiraEn;

      allow delete: if esDueno(resource.data.negocioId);
    }
  }
}
